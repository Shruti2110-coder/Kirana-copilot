# MongoDB — local Docker (see docker-compose.yml). For deploy, use a free
# MongoDB Atlas cluster: mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/kirana
MONGODB_URI="mongodb://localhost:27018/kirana"

# Public URL of the app (used for PayPal return/cancel URLs)
APP_URL="http://localhost:3000"

# AI — get a free key at https://aistudio.google.com/apikey
# Leave empty to use the built-in offline parser (text only, no voice).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# PayPal Sandbox — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
# PayPal does not support domestic INR payments in India, so sandbox uses USD.
PAYPAL_CURRENCY="USD"
# Rough conversion for the demo: amounts are stored in INR, charged in USD.
INR_PER_USD="84"
# Webhook ID from the PayPal dashboard (for signature verification)
PAYPAL_WEBHOOK_ID=""

# Shop shown in the demo
SHOP_NAME="Apna Bazaar Kirana"
SHOP_OWNER="Rajesh ji"

# If GEMINI_MODEL's daily free quota runs out, the app retries once with this model.
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
